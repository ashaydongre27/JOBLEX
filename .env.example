# Server Configuration
PORT=3000

# Google Gemini API (Primary AI Provider)
# Supports multiple environment variable names for flexibility
GOOGLE_AI_STUDIO_MAIN=  # Main Google AI Studio API Key (gemini-3.6-flash, etc.)
GOOGLE_AI_STUDIO_BACKUP=  # Backup Google AI Studio API Key
GEMINI_API_KEY=  # Alternative name for GOOGLE_AI_STUDIO_MAIN
GOOGLE_API_KEY=  # Alternative name for GOOGLE_AI_STUDIO_MAIN
GOOGLE_API_KEY_MAIN=  # Alternative name for GOOGLE_AI_STUDIO_MAIN
GOOGLE_API_KEY_BACKUP=  # Alternative name for GOOGLE_AI_STUDIO_BACKUP
# Aliases used in ai.service.js:
gooleaistudiomain=  # Alternative name for GOOGLE_AI_STUDIO_MAIN
gooleaistudiobackup=  # Alternative name for GOOGLE_AI_STUDIO_BACKUP

# NVIDIA NIM API (Optional Multi-tier fallback)
# Primary LangGraph model provider for AI orchestration
NVIDIA_API_KEY=  # NVIDIA NIM API Key (for models like nemotron-3-ultra-550b-a55b)

# Supabase Database & Auth Configuration
# PostgreSQL database via Supabase (primary) with local fallback
SUPABASE_URL=  # Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_ANON_KEY=  # Supabase anon key (for client-side operations)
SUPABASE_SERVICE_ROLE_KEY=  # Supabase service role key (for server-side operations)
SUPABASE_SECRET_KEY=  # Alternative name for SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PUBLISHABLE_KEY=  # Alternative supabase key (if needed)

# Additional configuration variables (add as needed based on service requirements)
# Example: API keys for other services
# OPENAI_API_KEY=  # OpenAI API key (if using OpenAI models)
# anthropic_api_key=  # Anthropic API key (if using Claude models)
